# Secrets and local configuration
**/.env
**/.env.*
!**/.env.example

# Python environments, caches and reports
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.coverage
**/htmlcov/
**/c-*/

# Runtime state, databases and logs
**/runtime/*
!**/runtime/.gitkeep
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log

# Frontend dependencies and generated output
**/node_modules/
**/dist/
**/.vite/

# IDE and OS files
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db
