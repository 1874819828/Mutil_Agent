# 复制为 .env 后填写；不要把真实密钥提交到版本库。
# DeepSeek 使用 deepseek；OpenAI Responses API 使用 openai；离线演示使用 mock。
PROVIDER_MODE=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# OpenAI 模式可选：为不同角色指定独立模型；未设置时回退到 LLM_MODEL。
OPENAI_MANAGER_MODEL=
OPENAI_DEVELOPER_MODEL=
OPENAI_REVIEWER_MODEL=

# DeepSeek 模式也支持专用变量；未设置时继续使用上面的 LLM_* 通用变量。
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_MANAGER_MODEL=
DEEPSEEK_DEVELOPER_MODEL=
DEEPSEEK_REVIEWER_MODEL=

# 可选运行限制。
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=12000
LLM_MAX_429_RETRIES=2
